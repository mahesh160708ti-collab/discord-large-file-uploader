# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uploader

# Storage Engine: 'local' (built-in disk storage, zero external accounts needed) or 's3' (Cloudflare R2 / AWS S3)
STORAGE_TYPE=local

# S3 / Cloudflare R2 Storage Configuration (only needed if STORAGE_TYPE=s3)
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=discord-uploads
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Web Service Configuration
PORT=3000
BASE_URL=http://localhost:3000

# Limits and Quotas
MAX_FILE_SIZE_BYTES=2147483648
DEFAULT_USER_QUOTA_BYTES=5368709120

# Administration
ADMIN_DISCORD_USER_IDS=your_discord_user_id
